[flake8]
max-line-length = 100
extend-ignore = E203, E501, W503, F541, E722, E731
per-file-ignores =
    __init__.py:F401,F403
    optimization_benchmarks/metadata.py:F401,F403,F405
    optimization_benchmarks/functions.py:E203
    optimization_benchmarks/visualization.py:E722,F811,F841,F401
    optimization_benchmarks/benchmarking.py:F401,F541
    optimization_benchmarks/cli.py:F401
    optimization_benchmarks/utils.py:F401
    tests/*.py:F401,F811
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    *.egg-info
